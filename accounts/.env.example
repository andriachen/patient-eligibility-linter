# Copy to .env.local for `npm run dev`, and add both to the Vercel project.
# Supabase dashboard: Project Settings -> API. Use the anon/publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: where the StageShare web app runs. Leave unset on Vercel (it shares the domain
# at /); `npm run dev` defaults to http://localhost:3010.
NEXT_PUBLIC_WEB_URL=
